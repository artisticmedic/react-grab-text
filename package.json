{
  "name": "react-grab-text",
  "version": "0.2.0",
  "description": "Text and Deck tools for React Grab \u2014 edit text inline and batch grabs into one structured copy",
  "keywords": [
    "react-grab",
    "react-grab-plugin",
    "copyediting",
    "devtools",
    "react"
  ],
  "license": "MIT",
  "author": {
    "name": "Tim Gailey"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artisticmedic/react-grab-text.git"
  },
  "homepage": "https://github.com/artisticmedic/react-grab-text#readme",
  "bugs": {
    "url": "https://github.com/artisticmedic/react-grab-text/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": "./dist/global.global.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "test": "playwright test"
  },
  "peerDependencies": {
    "react-grab": ">=0.1.49"
  },
  "peerDependenciesMeta": {
    "react-grab": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grab": "0.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
